NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never prefix these variables with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# Invitation notices use the hosting's /usr/sbin/sendmail. No SMTP password.
# Keep disabled outside a server with an authorized local mail service.
INVITATION_MAIL_ENABLED=false
MAIL_FROM_ADDRESS=notificacione@alldecorpatio.com
MAIL_FROM_NAME=SaasAlldecor
# Absolute server-only directory outside the web root, containing SHA-256 named PDFs.
HISTORICAL_FILES_ROOT=
