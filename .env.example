NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server only. Never prefix these variables with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-4o-mini
# Invitation notices use the hosting's /usr/sbin/sendmail. No SMTP password.
# Keep disabled outside a server with an authorized local mail service.
INVITATION_MAIL_ENABLED=false
INVOICE_MAIL_ENABLED=false
# Invoice mail is opt-in per tenant after recipient and sender verification.
INVOICE_MAIL_COMPANY_IDS=
MAIL_FROM_ADDRESS=notificacione@alldecorpatio.com
MAIL_FROM_NAME=SaasAlldecor
# Absolute server-only directory outside the web root, containing SHA-256 named PDFs.
HISTORICAL_FILES_ROOT=
# Queue foundation only; leave false until all writers and adapters are verified.
OPERATION_QUEUE_ENABLED=false
# For staging: set APP_ENVIRONMENT=staging, use its own Supabase ref and URL,
# disable invitation mail and leave OPENAI_API_KEY empty. Never copy live data.
APP_ENVIRONMENT=production
STAGING_SUPABASE_PROJECT_REF=
# Staging only: enable after the private Auth hook has captured a synthetic email.
# Allows recovery for @saasalldecor.invalid only; does not enable external mail.
STAGING_AUTH_EMAIL_CAPTURE_VERIFIED=false
# Enable only after a real encrypted remote backup is verified and receipts exist.
BACKUP_MONITOR_ENABLED=false
BACKUP_RECEIPT_ROOT=
# Postal geocoding is off by default. See docs/GEOCODIFICACION.md before enabling.
# staging: synthetic (explicit fixtures only); production: nominatim, after review.
ZONE_GEOCODER_PROVIDER=disabled
ZONE_GEOCODER_POLICY_REVIEWED=false
ZONE_GEOCODER_SINGLE_HOST=
ZONE_GEOCODER_DIRECTORY=
ZONE_GEOCODER_ENDPOINT=https://nominatim.openstreetmap.org/search
ZONE_GEOCODER_CONTACT_URL=https://app.alldecorpatio.com

# Receipt IA only; dedicated server credentials, disabled until configured.
# No provider/model defaults. Never expose these keys with NEXT_PUBLIC_.
RECEIPT_REVIEW_ENABLED=false
RECEIPT_REVIEW_SUPABASE_SERVICE_KEY=
RECEIPT_AI_ANTHROPIC_API_KEY=
RECEIPT_AI_ANTHROPIC_MODEL=
RECEIPT_AI_OPENAI_API_KEY=
RECEIPT_AI_OPENAI_MODEL=
# Isolated synthetic receipt bank in staging. Does not enable mail or Assistant.
STAGING_RECEIPT_AI_TEST_ENABLED=false
STAGING_RECEIPT_AI_TEST_COMPANIES=
# Isolated cartography bench; public tile coordinates only, no customer data.
# No general staging delivery changes. Exact synthetic company, after OSM review.
STAGING_CARTOGRAPHY_TEST_ENABLED=false
STAGING_CARTOGRAPHY_OSM_REVIEWED=false
STAGING_CARTOGRAPHY_TEST_COMPANY=
